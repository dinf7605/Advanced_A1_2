# 실제 키를 여기에 쓰지 마십시오. 이 파일은 키 "이름"만 알려주는 견본이며 커밋됩니다.
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채우십시오.  cp .env.example .env

# --- LLM (필수) ---
GEMINI_API_KEY=

# --- 지도/장소 검색 제공자 선택 (선택, 기본값 kakao) ---
# kakao | naver
PLACE_PROVIDER=

# PLACE_PROVIDER=kakao 일 때 필요
KAKAO_REST_API_KEY=

# PLACE_PROVIDER=naver 일 때 필요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
